# GEMINI_API_KEY: Required for server-side Gemini AI Idea Generator calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Supabase architecture keys (for future production cloud persistence)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-only Payment Provider keys (never prefix with VITE_ or expose to browser)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
